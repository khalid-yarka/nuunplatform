{% extends "base.html" %}

{% block title %}Register - Student Platform{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/register.css') }}" />
{% endblock %}

{% block content %}
<body class="auth-page">
    <div class="auth-container">
        <div class="auth-card">
            <!-- Logo -->
            <div class="auth-logo">
                <img src="{{ url_for('static', filename='images/logo.png') }}" alt="Logo" />
            </div>

            <h1 class="auth-title">Create <span>Account</span></h1>
            <p class="auth-subtitle">Join our learning platform</p>

            <hr class="divider" />

            <form method="POST" action="{{ url_for('register') }}" class="auth-form" id="registerForm">
                <!-- Phone -->
                <div class="form-group">
                    <label>📞 Phone Number <span class="required">*</span></label>
                    <div class="input-wrapper" id="phoneWrapper">
                        <span class="phone-prefix">+252</span>
                        <input type="tel" name="phone" id="phone" placeholder="61 234 5678" maxlength="9" required />
                    </div>
                    <div class="error-message" id="phoneError">Please enter a valid 9-digit phone number</div>
                </div>

                <!-- Password -->
                <div class="form-group">
                    <label>🔒 Password <span class="required">*</span></label>
                    <div class="input-wrapper" id="passwordWrapper">
                        <span class="input-icon"><i class="fas fa-lock"></i></span>
                        <input type="password" name="password" id="password" placeholder="Minimum 8 characters" required />
                        <button type="button" class="toggle-password" onclick="togglePassword('password')">
                            <i class="fas fa-eye" id="passwordIcon"></i>
                        </button>
                    </div>
                    <div class="error-message" id="passwordError">Password must be at least 8 characters</div>
                </div>

                <!-- Confirm Password -->
                <div class="form-group">
                    <label>🔒 Confirm Password <span class="required">*</span></label>
                    <div class="input-wrapper" id="confirmWrapper">
                        <span class="input-icon"><i class="fas fa-check-circle"></i></span>
                        <input type="password" id="confirmPassword" placeholder="Re-enter password" required />
                        <button type="button" class="toggle-password" onclick="togglePassword('confirmPassword')">
                            <i class="fas fa-eye" id="confirmIcon"></i>
                        </button>
                    </div>
                    <div class="error-message" id="confirmError">Passwords do not match</div>
                </div>

                <hr class="divider" />

                <!-- Full Name -->
                <div class="form-group">
                    <label>👤 Full Name <span class="required">*</span></label>
                    <div class="name-row">
                        <div class="input-wrapper" id="firstNameWrapper">
                            <input type="text" name="first_name" id="firstName" placeholder="First" required />
                        </div>
                        <div class="input-wrapper" id="middleNameWrapper">
                            <input type="text" name="middle_name" id="middleName" placeholder="Middle" />
                        </div>
                        <div class="input-wrapper" id="lastNameWrapper">
                            <input type="text" name="last_name" id="lastName" placeholder="Last" required />
                        </div>
                    </div>
                    <div class="error-message" id="nameError">First and Last name are required</div>
                </div>

                <hr class="divider" />

                <!-- Location -->
                <div class="form-group">
                    <label>📍 Location <span class="required">*</span></label>
                    <div class="input-wrapper" id="locationWrapper">
                        <span class="input-icon"><i class="fas fa-map-marker-alt"></i></span>
                        <select name="location" id="location" required onchange="updateSchools(); toggleCurriculum();">
                            <option value="">Select Location</option>
                            <option value="SO">🇸🇴 Somalia (SO)</option>
                            <option value="PL">🇸🇴 Puntland (PL)</option>
                            <option value="SL">🇸🇴 Somaliland (SL)</option>
                        </select>
                    </div>
                    <div class="error-message" id="locationError">Please select your location</div>
                </div>

                <!-- NEW: Curriculum (only for PL) -->
                <div class="form-group" id="curriculumGroup" style="display: none;">
                    <label>📚 Curriculum <span class="required">*</span></label>
                    <div class="input-wrapper">
                        <span class="input-icon"><i class="fas fa-book-open"></i></span>
                        <select name="curriculum" id="curriculum">
                            <option value="">Select Curriculum</option>
                            <option value="general">General</option>
                            <option value="science">Science</option>
                            <option value="arts">Arts</option>
                        </select>
                    </div>
                    <div class="error-message" id="curriculumError">Please select your curriculum.</div>
                </div>

                <!-- City -->
                <div class="form-group">
                    <label>🌆 City <span class="required">*</span></label>
                    <div class="input-wrapper" id="cityWrapper">
                        <span class="input-icon"><i class="fas fa-city"></i></span>
                        <input type="text" name="city" id="city" placeholder="Enter city name" required />
                    </div>
                    <div class="error-message" id="cityError">City is required</div>
                </div>

                <hr class="divider" />

                <!-- School -->
                <div class="form-group">
                    <label>🏫 School <span class="required">*</span></label>
                    <div class="input-wrapper" id="schoolWrapper">
                        <span class="input-icon"><i class="fas fa-school"></i></span>
                        <select name="school" id="school" required onchange="handleSchoolSelect()">
                            <option value="">Select School</option>
                        </select>
                    </div>
                    <div class="error-message" id="schoolError">Please select or enter your school</div>

                    <div class="school-manual" id="schoolManual">
                        <div class="input-wrapper">
                            <span class="input-icon"><i class="fas fa-pen"></i></span>
                            <input type="text" name="school_manual" id="schoolManualInput" placeholder="Enter school name" />
                        </div>
                    </div>
                </div>

                <!-- Grade -->
                <div class="form-group">
                    <label>📚 Grade / Level <span class="required">*</span></label>
                    <div class="input-wrapper" id="gradeWrapper">
                        <span class="input-icon"><i class="fas fa-graduation-cap"></i></span>
                        <select name="grade" id="grade" required>
                            <option value="">Select Grade</option>
                            <option value="7aad">7aad</option>
                            <option value="8aad">8aad</option>
                            <option value="Sare 3aad">Sare 3aad</option>
                            <option value="Sare 4aad">Sare 4aad</option>
                        </select>
                    </div>
                    <div class="error-message" id="gradeError">Please select your grade</div>
                </div>

                <hr class="divider" />

                <button type="submit" class="btn-submit">
                    <i class="fas fa-rocket"></i> Create Account
                </button>
            </form>

            <div class="auth-footer">
                <p>Already have an account? <a href="{{ url_for('login') }}">Sign in</a></p>
                <p class="terms">By creating an account, you agree to our Terms of Service</p>
            </div>
        </div>
    </div>
</body>
{% endblock %}

{% block extra_js %}
<script src="{{ url_for('static', filename='js/register.js') }}"></script>
<script>
    // Password toggle
    function togglePassword(fieldId) {
        const input = document.getElementById(fieldId);
        const icon = document.getElementById(fieldId + 'Icon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'fas fa-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'fas fa-eye';
        }
    }

    // School data
    const schoolData = {
        'SO': ['Mogadishu Secondary School', 'Kismayo High School', 'Baidoa School', 'Jowhar Academy'],
        'PL': ['Garowe Secondary School', 'Bosaso High School', 'Galkayo School', 'Qardho Academy'],
        'SL': ['Sheikh Secondary School', 'Amoud School', 'Hargeisa High School', 'Burco Academy']
    };

    function updateSchools() {
        const location = document.getElementById('location').value;
        const schoolSelect = document.getElementById('school');
        const manualDiv = document.getElementById('schoolManual');

        schoolSelect.innerHTML = '<option value="">Select School</option>';

        if (location && schoolData[location]) {
            schoolData[location].forEach(function(school) {
                const option = document.createElement('option');
                option.value = school;
                option.textContent = school;
                schoolSelect.appendChild(option);
            });
        }

        const manualOption = document.createElement('option');
        manualOption.value = 'manual';
        manualOption.textContent = '✏️ Add school manually';
        manualOption.style.color = '#FF3138';
        manualOption.style.fontWeight = '600';
        schoolSelect.appendChild(manualOption);

        manualDiv.classList.remove('active');
        document.getElementById('schoolManualInput').value = '';
    }

    function handleSchoolSelect() {
        const schoolSelect = document.getElementById('school');
        const manualDiv = document.getElementById('schoolManual');

        if (schoolSelect.value === 'manual') {
            manualDiv.classList.add('active');
            document.getElementById('schoolManualInput').focus();
            schoolSelect.removeAttribute('required');
        } else {
            manualDiv.classList.remove('active');
            document.getElementById('schoolManualInput').value = '';
            schoolSelect.setAttribute('required', 'required');
        }
    }

    // Toggle curriculum field for PL
    function toggleCurriculum() {
        const location = document.getElementById('location').value;
        const curriculumGroup = document.getElementById('curriculumGroup');
        const curriculumSelect = document.getElementById('curriculum');
        if (location === 'PL') {
            curriculumGroup.style.display = 'block';
            curriculumSelect.setAttribute('required', 'required');
        } else {
            curriculumGroup.style.display = 'none';
            curriculumSelect.removeAttribute('required');
            curriculumSelect.value = '';
        }
    }

    // Show/hide error helpers (if needed)
    function showError(wrapperId, errorId) {
        const wrapper = document.getElementById(wrapperId);
        if (wrapper) wrapper.classList.add('error');
        const error = document.getElementById(errorId);
        if (error) error.classList.add('visible');
    }

    function hideError(wrapperId, errorId) {
        const wrapper = document.getElementById(wrapperId);
        if (wrapper) wrapper.classList.remove('error');
        const error = document.getElementById(errorId);
        if (error) error.classList.remove('visible');
    }

    // Initial call
    document.addEventListener('DOMContentLoaded', function() {
        toggleCurriculum();
    });
</script>
{% endblock %}