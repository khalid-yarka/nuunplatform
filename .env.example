# ============================================
# NUUNPLATFORM .env.example
# Copy this file to .env and update values
# ============================================

# --------------------------------------------
# SECURITY (MUST CHANGE IN PRODUCTION)
# --------------------------------------------
SECRET_KEY=your-secret-key-here
ADMIN_ERROR_PASSWORD=your-admin-password-here
BACKUP_TRIGGER_TOKEN=your-backup-token-here

# --------------------------------------------
# DATABASE
# --------------------------------------------
DATABASE_PATH=nuunplatform.db
BOT_DATABASE_PATH=bot_data.db
DB_TIMEOUT=30.0
DB_BUSY_TIMEOUT=30000
DB_RETRY_ATTEMPTS=7
DB_RETRY_INITIAL_DELAY=0.1
DB_MAX_RETRY_DELAY=3.0
DB_RETRY_BACKOFF_MULTIPLIER=2.0

# --------------------------------------------
# SESSION
# --------------------------------------------
PERMANENT_SESSION_LIFETIME_DAYS=1
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
ADMIN_SESSION_TIMEOUT=1800

# --------------------------------------------
# PATHS
# --------------------------------------------
BACKUP_DIR=BACKUPS
LOG_DIR=logs
UPLOAD_FOLDER=static/uploads/pdfs

# --------------------------------------------
# BACKUP
# --------------------------------------------
BACKUP_ENABLED=true
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# --------------------------------------------
# QUIZ
# --------------------------------------------
RATING_TIME=10
LIVE_QUIZ_TIME_PER_QUESTION=30
LIVE_QUIZ_MAX_PARTICIPANTS=50

# --------------------------------------------
# RATE LIMITING
# --------------------------------------------
RATE_LIMIT_DEFAULT="200 per day;50 per hour"
RATE_LIMIT_LOGIN="5 per minute"
RATE_LIMIT_ADMIN="10 per minute"

# --------------------------------------------
# LOGGING
# --------------------------------------------
LOG_LEVEL=WARNING
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --------------------------------------------
# EMAIL (for error reporting)
# --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
ERROR_EMAIL_DEDUP_WINDOW=300

# --------------------------------------------
# ERROR LOGGING
# --------------------------------------------
ERROR_RETENTION_DAYS=30
ERROR_LOG_SAMPLE_RATE=1.0

# --------------------------------------------
# CACHE (Redis optional)
# --------------------------------------------
REDIS_URL=
CACHE_LOCAL_MAX_SIZE=1000
CACHE_LOCAL_TTL=60
CACHE_SERIALIZATION=json
REDIS_MAX_CONNECTIONS=10
CACHE_WORKER_ENABLED=false

# --------------------------------------------
# TELEGRAM BOT (REQUIRED for bot features)
# --------------------------------------------
TELEGRAM_BOT_TOKEN="8875597704:AAF118CXKZbNCzw9oJZEND8zcGbSaw8kcFQ"
TELEGRAM_ADMIN_IDS=2094426161
BASE_URL=https://zabots1.pythonanywhere.com

# --------------------------------------------
# PDF ADMIN PANEL (MUST CHANGE IN PRODUCTION)
# --------------------------------------------
PDF_ADMIN_SECRET_PATH=/pdf-admin-secret-path
PDF_ADMIN_USERNAME=admin
PDF_ADMIN_PASSWORD=samir
PDF_ADMIN_SESSION_TIMEOUT=1800

# --------------------------------------------
# FLASK (for development only)
# --------------------------------------------
FLASK_DEBUG=false
PORT=5000